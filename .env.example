# Public base URL of the site (used for canonical URLs, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (Resend) ---
# Sign up at https://resend.com, create an API key, and set these.
# Without them the contact form still "works" in dev: it logs the message
# to the server console and reports success.
RESEND_API_KEY=
# Where contact-form submissions are delivered:
CONTACT_TO_EMAIL=you@example.com
# From address. Use resend.dev while testing, or a verified domain in prod:
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
